{
  "datasets": [
    {
      "name": "ds_current",
      "displayName": "Current coverage (latest run)",
      "queryLines": [
        "SELECT full_name, team, dataset_fill_rate, certification_tier, certification_supported_by_evidence FROM workspace.platform.coverage_history WHERE run_id = (SELECT run_id FROM workspace.platform.coverage_history ORDER BY run_timestamp DESC LIMIT 1) ORDER BY full_name"
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "Coverage trend by run",
      "queryLines": [
        "SELECT run_timestamp, AVG(dataset_fill_rate) AS avg_fill_rate FROM workspace.platform.coverage_history GROUP BY run_timestamp ORDER BY run_timestamp"
      ]
    },
    {
      "name": "ds_outcome",
      "displayName": "Outcome measure (latest run, SIMULATED)",
      "queryLines": [
        "SELECT outcome_measure_name, AVG(outcome_measure_value) AS avg_value, outcome_measure_unit FROM workspace.platform.coverage_history WHERE run_id = (SELECT run_id FROM workspace.platform.coverage_history ORDER BY run_timestamp DESC LIMIT 1) GROUP BY outcome_measure_name, outcome_measure_unit"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_coverage",
      "displayName": "Coverage",
      "layout": [
        {
          "widget": {
            "name": "w_overall_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_current",
                  "fields": [
                    {
                      "name": "avg(dataset_fill_rate)",
                      "expression": "AVG(`dataset_fill_rate`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "avg(dataset_fill_rate)",
                  "displayName": "Overall fill rate (latest run)",
                  "format": {
                    "type": "number-percent"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Overall fill rate (latest run)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "w_outcome_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_outcome",
                  "fields": [
                    {
                      "name": "avg_value",
                      "expression": "`avg_value`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "avg_value",
                  "displayName": "Time to first query (days) -- SIMULATED, not real telemetry"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Time to first query (days) -- SIMULATED, not real telemetry"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 0,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "w_trend_line",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_trend",
                  "fields": [
                    {
                      "name": "run_timestamp",
                      "expression": "`run_timestamp`"
                    },
                    {
                      "name": "avg_fill_rate",
                      "expression": "`avg_fill_rate`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "run_timestamp",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Run"
                },
                "y": {
                  "fieldName": "avg_fill_rate",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Overall fill rate"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Overall fill rate trend across runs"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 8,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "2a3cb356",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_current",
                  "fields": [
                    {
                      "name": "team",
                      "expression": "`team`"
                    },
                    {
                      "name": "avg(dataset_fill_rate)",
                      "expression": "AVG(`dataset_fill_rate`)"
                    },
                    {
                      "name": "full_name",
                      "expression": "`full_name`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Dataset fill rate by dataset"
              },
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "avg(dataset_fill_rate)",
                  "displayName": "Fill rate",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "y": {
                  "fieldName": "full_name",
                  "displayName": "Dataset",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "color": {
                  "fieldName": "team",
                  "displayName": "Team",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 8,
            "height": 6
          }
        }
      ],
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1"
    }
  ],
  "uiSettings": {
    "genieSpace": {
      "isEnabled": false,
      "enablementMode": "ENABLEMENT_MODE_UNSPECIFIED"
    }
  }
}
