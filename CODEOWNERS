/contracts/_template.yaml              @data-platform-team
/change_classes.yaml                   @data-platform-team
/dq_registry.yaml                      @data-platform-team
/glossary/                             @data-platform-team
/src/                                  @data-platform-team
/cli/                                  @data-platform-team
/dashboard/                            @data-platform-team
/.github/                              @data-platform-team
